# ASX Intelligence Dashboard Environment Variables
# Copy this file to .env and edit values before running docker compose.

# PostgreSQL
POSTGRES_DB=asx
POSTGRES_USER=asx_user
POSTGRES_PASSWORD=change_me

# OpenAI (optional if using local LLM only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Local LLM (LM Studio or OpenAI-compatible local server)
LOCAL_LLM_URL=http://host.docker.internal:1234/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# Choose provider order, first available provider wins.
# Examples: local,openai OR openai,local
LLM_PROVIDER_ORDER=local,openai

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_HOURS=24
