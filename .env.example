# ASX Intelligence Dashboard Environment Variables
# Copy this file to .env and edit values before running docker compose.

# PostgreSQL
POSTGRES_DB=asx
POSTGRES_USER=asx_user
POSTGRES_PASSWORD=change_me

# OpenAI (optional if using local LLM only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Local LLM (LM Studio or OpenAI-compatible local server)
LOCAL_LLM_URL=http://host.docker.internal:1234/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# Choose provider order, first available provider wins.
# Default: groq first (fast 128K context), local fallback, OpenAI last resort
LLM_PROVIDER_ORDER=groq,local,openai

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_HOURS=24

# ─── WhatsApp Business API (Meta Cloud API) ───────────────────────────────────
# Get these from https://developers.facebook.com → Your App → WhatsApp → API Setup
# FREE: 1,000 service conversations/month — plenty for 3-4 test users ($0 cost)
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
# The ACTUAL phone number customers will send messages to (e.g. 61412345678 for AU)
# Used to generate wa.me share links for customers. Include country code, no spaces or +
WHATSAPP_BUSINESS_PHONE=61412345678
# Set this to any random string — you'll enter it in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=my_random_verify_token_123

# ─── n8n Workflow Automation ─────────────────────────────────────────────────
# Self-hosted n8n at https://n8n.akstest.win (exposed via Cloudflare)
N8N_HOST=n8n.akstest.win
N8N_PROTOCOL=https
N8N_USER=admin
N8N_PASSWORD=changeme_set_a_strong_password
# Must be exactly 32 characters for AES-256
N8N_ENCRYPTION_KEY=change-this-to-32-char-key-xxxxx

