    },
    {
      "parameters": {
        "jsCode": "// Meta sends: ?hub.mode=subscribe&hub.verify_token=TOKEN&hub.challenge=CHALLENGE\nconst query = $input.first().json.query || {};\nconst verifyToken = $env.WHATSAPP_VERIFY_TOKEN || 'my_verify_token';\n\nif (query['hub.mode'] === 'subscribe' && query['hub.verify_token'] === verifyToken) {\n  return [{ json: { challenge: query['hub.challenge'] } }];\n}\nreturn [{ json: { error: 'token mismatch' } }];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
